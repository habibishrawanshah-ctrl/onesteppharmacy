{
  "framework": null,
  "buildCommand": "bash pharmacy_ecommerce/scripts/vercel-build.sh",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "/api/index" }
  ],
  "cleanUrls": true
}