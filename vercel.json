{
  "rootDirectory": "pharmacy_ecommerce",
  "buildCommand": "pip install -r requirements.txt && python manage.py collectstatic --noinput",
  "outputDirectory": ".",
  "functions": {
    "api/**/*.py": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "/api/wsgi.py" }
  ],
  "cleanUrls": true
}
