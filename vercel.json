{
  "buildCommand": "cd pharmacy_ecommerce && pip install -r requirements.txt && python manage.py collectstatic --noinput",
  "outputDirectory": "pharmacy_ecommerce",
  "functions": {
    "api/**/*.py": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/static/(.*)", "dest": "/staticfiles/$1" },
    { "src": "/(.*)", "dest": "/api/wsgi.py" }
  ],
  "cleanUrls": true
}
